#!/usr/bin/env python3
# screenpipe — AI that knows everything you've seen, said, or heard
# https://screenpipe.com

"""Prepare an already cloned, marked hybrid fixture for storage API experiments.

Input databases must be closed consistent snapshots. This does not clone a live
WAL database. All changes are confined to the supplied benchmark fixture.
"""

import argparse
import json
from pathlib import Path
import sqlite3

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--fixture", required=True, type=Path)
parser.add_argument("--source-snapshot", type=Path)
parser.add_argument("--lookup", action="store_true")
parser.add_argument("--cache-mib", type=int)
parser.add_argument("--decoders", type=int)
parser.add_argument("--retries", type=int)
args = parser.parse_args()
root = args.fixture.resolve(strict=True)
if not (root / ".screenpipe-api-benchmark").is_file():
    raise ValueError("fixture must be an explicitly marked disposable copy")
descriptor = json.loads((root / "storage.json").read_text())
index = (root / descriptor["index"]).resolve(strict=True)
if not index.is_relative_to(root):
    raise ValueError("index escapes fixture")
if Path(str(index) + "-wal").exists() and Path(str(index) + "-wal").stat().st_size:
    raise ValueError("close the fixture server and checkpoint before preparation")
connection = sqlite3.connect(index.as_uri() + "?mode=rw", uri=True)
if args.cache_mib is not None:
    descriptor["budget"]["decode_bytes"] = args.cache_mib * 1024 * 1024
if args.decoders is not None:
    descriptor["budget"]["concurrent_decodes"] = args.decoders
if args.retries is not None:
    descriptor["budget"]["read_attempts"] = args.retries
connection.execute("UPDATE storage_metadata SET descriptor=?", (json.dumps(descriptor),))
connection.execute("CREATE TABLE _benchmark_revocation(id INTEGER PRIMARY KEY,revision INTEGER NOT NULL)")
connection.execute("INSERT INTO _benchmark_revocation VALUES(1,0)")
for name in ["frames", "audio_transcriptions", "ui_events", "semantic_items", "_bulk_element_rows"]:
    columns = {r[1] for r in connection.execute(f"PRAGMA table_info({name})")}
    if "redacted_at" in columns:
        connection.execute(f"""CREATE TRIGGER _benchmark_revoke_{name}_redaction
            AFTER UPDATE OF redacted_at ON {name} WHEN NEW.redacted_at IS NOT OLD.redacted_at
            BEGIN UPDATE _benchmark_revocation SET revision=revision+1; END""")
    if name != "_bulk_element_rows":
        connection.execute(f"""CREATE TRIGGER _benchmark_revoke_{name}_delete AFTER DELETE ON {name}
            BEGIN UPDATE _benchmark_revocation SET revision=revision+1; END""")
connection.execute("""CREATE TRIGGER _benchmark_revoke_policy AFTER UPDATE OF policy,required_surfaces ON storage_metadata
    WHEN NEW.policy IS NOT OLD.policy OR NEW.required_surfaces IS NOT OLD.required_surfaces
    BEGIN UPDATE _benchmark_revocation SET revision=revision+1; END""")
connection.execute("""CREATE TRIGGER _benchmark_revoke_replace AFTER UPDATE OF generation ON frame_payloads
    WHEN (SELECT maintenance FROM storage_metadata)=1 AND NEW.generation!=OLD.generation
      AND (NEW.completed_surfaces!=0 OR NEW.policy!=OLD.policy)
    BEGIN UPDATE _benchmark_revocation SET revision=revision+1; END""")
connection.execute("""CREATE TRIGGER _benchmark_revoke_element_replace AFTER INSERT ON _bulk_element_rows
    WHEN NEW._archive_generation>1 BEGIN UPDATE _benchmark_revocation SET revision=revision+1; END""")
if args.lookup:
    if args.source_snapshot is None:
        raise ValueError("--lookup requires the original closed --source-snapshot")
    source = args.source_snapshot.resolve(strict=True)
    if Path(str(source) + "-wal").exists() and Path(str(source) + "-wal").stat().st_size:
        raise ValueError("source must be a closed consistent snapshot")
    connection.execute("ATTACH DATABASE ? AS source", (source.as_uri() + "?mode=ro&immutable=1",))
    connection.execute("""CREATE TABLE _benchmark_element_lookup(id INTEGER PRIMARY KEY,
        frame_id INTEGER NOT NULL,sort_order INTEGER,kind_id INTEGER NOT NULL,on_screen INTEGER)""")
    connection.execute("""INSERT INTO _benchmark_element_lookup
        SELECT e.id,e.frame_id,e.sort_order,k.id,e.on_screen FROM source.elements e
        JOIN _bulk_element_kinds k ON k.source=e.source AND k.role=e.role""")
    connection.execute("""CREATE VIEW _benchmark_element_search AS SELECT e.id,e.frame_id,e.sort_order,
        e.on_screen,k.source,k.role FROM _benchmark_element_lookup e JOIN _bulk_element_kinds k ON k.id=e.kind_id""")
    for event in ["INSERT", "UPDATE"]:
        connection.execute(f"""CREATE TRIGGER _benchmark_lookup_{event} AFTER {event} ON _bulk_element_rows BEGIN
            DELETE FROM _benchmark_element_lookup WHERE id=NEW.id;
            INSERT INTO _benchmark_element_lookup SELECT NEW.id,NEW.frame_id,NEW.sort_order,k.id,NEW.on_screen
                FROM _bulk_element_kinds k WHERE k.source=NEW.source AND k.role=NEW.role AND NEW._archive_deleted=0;
            END""")
    connection.execute("ANALYZE _benchmark_element_lookup")
connection.commit()
connection.execute("PRAGMA wal_checkpoint(TRUNCATE)")
connection.close()
(root / "storage.json").write_text(json.dumps(descriptor, indent=2) + "\n")
print(json.dumps({"fixture": str(root), "index_bytes": index.stat().st_size, "lookup": args.lookup, "budget": descriptor["budget"]}))
