  "cards": [
    {
      "dot": "amber",
      "title": "Local storage and PII",
      "items": [
        "New root only; existing SQLite mode stays unchanged.",
        "PII enabled: redact before sealing; failures remain staged.",
        "Archived PII: replace payload + index, clear caches, rewrite / remove old files."
      ]
    },
    {
      "dot": "cyan",
      "title": "Data Sync and enterprise",
      "items": [
        "Data Sync returns remote search results; no local DB import.",
        "Uploads read logical records; existing cloud formats stay unchanged.",
        "Enterprise reads the local API; both SQLite and Parquet serve the same fields."
      ]
    }
  ]
