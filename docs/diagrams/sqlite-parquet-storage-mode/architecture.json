  "cards": [
    {
      "dot": "slate",
      "title": "Storage ownership",
      "items": [
        "SQLite owns search, grouped counts, relationships and mutable state.",
        "Parquet owns complete element records and large text, JSON and logs.",
        "Range and frame references resolve compressed history by record ID."
      ]
    },
    {
      "dot": "slate",
      "title": "Complete records throughout the lifecycle",
      "items": [
        "Logical SQL merges immutable records and transactional replacements.",
        "Migration streams bounded batches, verifies, and activates; the original stays until explicit deletion.",
        "Privacy completion gates sealing; retired files wait for SQL snapshots and readers."
      ]
    }
  ]
